{
  "name": "cdn-buddy",
  "version": "1.0.0",
  "description": "Hybrid CDN and Object Storage File Manager with Metrics and Previews",
  "main": "server/src/index.ts",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"tsx server/src/index.ts\" \"npm --prefix client run dev\"",
    "server": "tsx server/src/index.ts",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build"
  },
  "keywords": [
    "cdn",
    "s3",
    "r2",
    "minio",
    "keycdn",
    "storage",
    "metrics",
    "video-duration"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mime-types": "^3.0.2",
    "music-metadata": "^12.1.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.1.2",
    "typescript": "^7.0.2"
  }
}
